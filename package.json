{
  "name": "dsh-aurabot-unified",
  "version": "0.2.1",
  "description": "大肥鱼 QQ 与微信合并版，使用共同的设置和主人记忆",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hogolic/aurabot-qq-wechat.git"
  },
  "private": true,
  "type": "module",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["slots"], "external": ["react"] }
  },
  "files": ["host.js", "shared", "channels", "client/client.js", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=22.13.0" }
}
